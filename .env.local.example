# Supabase values are used only by server-side route handlers in this project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Only needed later for server-side administrative writes. Never expose it.
SUPABASE_SECRET_KEY=

# TravelTime credentials must never use a NEXT_PUBLIC_ prefix.
TRAVELTIME_APP_ID=4e4be0cb
TRAVELTIME_API_KEY=
